---
import Layout from "../layouts/Layout.astro";
import SparkleCanvas from "../components/SparkleCanvas.astro";
import Header from "../components/Header.astro";
import WelcomeOverlay from "../components/WelcomeOverlay.astro";
import StoryGuide from "../components/StoryGuide.astro";
import BirthdayCake from "../components/BirthdayCake.astro";
import InvitationModal from "../components/InvitationModal.astro";
import ToastBanner from "../components/ToastBanner.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Una Fiesta de cumpleaños para Sofía">
	<SparkleCanvas />
	<Header />
	<WelcomeOverlay />

	<main
		class="relative z-10 flex-1 w-full max-w-6xl mx-auto px-4 py-2 flex flex-col lg:flex-row items-center justify-center gap-6 lg:gap-10"
	>
		<StoryGuide />
		<BirthdayCake />
	</main>

	<InvitationModal />
	<ToastBanner />
	<Footer />
</Layout>
