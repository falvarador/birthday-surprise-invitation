---
import Layout from "../layouts/Layout.astro";
import SparkleCanvas from "../components/SparkleCanvas.astro";
import Header from "../components/Header.astro";
import WelcomeOverlay from "../components/WelcomeOverlay.astro";
import StoryGuide from "../components/StoryGuide.astro";
import BirthdayCake from "../components/BirthdayCake.astro";
import InvitationModal from "../components/InvitationModal.astro";
import ToastBanner from "../components/ToastBanner.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="✨ ¡Tienes una Invitación Real! | Cumpleaños #4 de Sofía 🎂👑">
	<SparkleCanvas />
	<Header />
	<WelcomeOverlay />

	<main
		class="relative z-10 flex-1 min-h-0 w-full max-w-6xl mx-auto px-3 sm:px-4 py-1 sm:py-2 flex flex-col lg:flex-row items-center justify-between lg:justify-center gap-1.5 sm:gap-3 lg:gap-10 overflow-hidden"
	>
		<StoryGuide />
		<BirthdayCake />
	</main>

	<InvitationModal />
	<ToastBanner />
	<Footer />
</Layout>
