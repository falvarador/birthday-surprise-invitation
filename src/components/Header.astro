<birthday-header class="contents">
	<!-- Desktop / Tablet Header (md: and above) -->
	<header
		class="hidden md:flex relative z-20 shrink-0 w-full max-w-6xl mx-auto px-3 sm:px-4 pt-2 pb-1 items-center justify-between gap-2"
	>
		<!-- Compact brand / Title left -->
		<div
			class="flex items-center gap-2 bg-white/85 backdrop-blur-md px-3 py-1 sm:py-1.5 rounded-full shadow-xs border border-palette-pink/60"
		>
			<span class="text-sm leading-none" aria-hidden="true">👑</span>
			<span
				class="text-sm font-bold tracking-wide text-palette-brown truncate"
			>
				Cumpleaños #<span id="nav-age-display" class="dynamic-age"
					>4</span
				> de <span id="nav-name-display" class="dynamic-name"
					>Sofía</span
				>
			</span>
		</div>

		<!-- Music button right -->
		<button
			type="button"
			id="btn-sound"
			data-action="sound"
			class="flex items-center gap-1.5 px-3 py-1 sm:py-1.5 rounded-full bg-white/90 hover:bg-palette-pink/40 text-palette-brown border border-palette-pink shadow-xs transition-all text-sm font-semibold active:scale-95 cursor-pointer shrink-0"
			aria-label="Alternar música mágica"
		>
			<span id="sound-icon" data-sound-icon aria-hidden="true">🎵</span>
			<span id="sound-label">Música</span>
		</button>
	</header>
</birthday-header>

<script>
	import { partyState, showToast } from "../scripts/partyStore";
	import { playSparkleChime } from "../scripts/audioManager";

	class BirthdayHeaderElement extends HTMLElement {
		connectedCallback() {
			const soundBtns = document.querySelectorAll('[data-action="sound"]');

			soundBtns.forEach((soundBtn) => {
				soundBtn.addEventListener("click", () => {
					partyState.audioEnabled = !partyState.audioEnabled;
					const icon = this.querySelector("#sound-icon");
					const mobileIcons =
						document.querySelectorAll("[data-sound-icon]");
					const label = this.querySelector("#sound-label");

					if (partyState.audioEnabled) {
						if (icon) icon.textContent = "🎵";
						mobileIcons.forEach((el) => {
							el.textContent = "🎵";
						});
						if (label) label.textContent = "Música";
						playSparkleChime();
						showToast("Sonidos mágicos activados");
					} else {
						if (icon) icon.textContent = "🔇";
						mobileIcons.forEach((el) => {
							el.textContent = "🔇";
						});
						if (label) label.textContent = "Silencio";
						showToast("Sonidos mágicos desactivados");
					}
				});
			});
		}
	}

	if (!customElements.get("birthday-header")) {
		customElements.define("birthday-header", BirthdayHeaderElement);
	}
</script>
