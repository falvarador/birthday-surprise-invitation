<sparkle-canvas class="contents">
	<canvas id="sparkle-canvas" class="fixed inset-0 pointer-events-none z-60"
	></canvas>

	<!-- Background decorative blobs using the exact palette -->
	<div
		class="fixed inset-0 overflow-hidden pointer-events-none z-0"
		aria-hidden="true"
	>
		<div
			class="absolute -top-24 -left-24 w-96 h-96 rounded-full bg-palette-pink/30 blur-3xl"
		>
		</div>
		<div
			class="absolute top-1/3 -right-24 w-80 h-80 rounded-full bg-palette-rose/25 blur-3xl"
		>
		</div>
		<div
			class="absolute -bottom-24 left-1/4 w-96 h-96 rounded-full bg-palette-gold/20 blur-3xl"
		>
		</div>
	</div>
</sparkle-canvas>

<script>
	interface Particle {
		x: number;
		y: number;
		vx: number;
		vy: number;
		size: number;
		color: string;
		alpha: number;
		decay: number;
		rotation: number;
		vRot: number;
		shape: "star" | "heart" | "circle" | "confetti";
	}

	class SparkleCanvasElement extends HTMLElement {
		private canvas!: HTMLCanvasElement;
		private ctx!: CanvasRenderingContext2D;
		private particles: Particle[] = [];
		private animationFrameId = 0;
		private readonly paletteColors = [
			"#966859",
			"#E6C0CF",
			"#DCB4B7",
			"#CDB37B",
			"#FFF5D6",
			"#F4A6B8",
			"#D4AF37",
		];

		private handleResize = () => {
			if (!this.canvas) return;
			this.canvas.width = window.innerWidth;
			this.canvas.height = window.innerHeight;
		};

		private handleCreateParticles = (e: Event) => {
			const customEvent = e as CustomEvent<{
				x: number;
				y: number;
				count?: number;
				type?: "mix" | "star" | "heart" | "circle" | "confetti";
			}>;
			const { x, y, count = 28, type = "mix" } = customEvent.detail;
			this.spawnParticles(x, y, count, type);
		};

		connectedCallback() {
			const canvas = this.querySelector("canvas");
			if (!canvas) return;
			this.canvas = canvas;
			const ctx = canvas.getContext("2d");
			if (!ctx) return;
			this.ctx = ctx;

			this.handleResize();
			window.addEventListener("resize", this.handleResize);
			window.addEventListener(
				"party:particles",
				this.handleCreateParticles,
			);
			this.animateParticles();
		}

		disconnectedCallback() {
			window.removeEventListener("resize", this.handleResize);
			window.removeEventListener(
				"party:particles",
				this.handleCreateParticles,
			);
			cancelAnimationFrame(this.animationFrameId);
		}

		private pickMixShape(): "star" | "heart" | "confetti" {
			const r = Math.random();
			if (r < 0.4) return "confetti";
			if (r < 0.75) return "star";
			return "heart";
		}

		private spawnParticles(
			x: number,
			y: number,
			count = 28,
			type: "mix" | "star" | "heart" | "circle" | "confetti" = "mix",
		) {
			for (let i = 0; i < count; i++) {
				const angle = Math.random() * Math.PI * 2;
				const speed = Math.random() * 7 + 2;
				this.particles.push({
					x,
					y,
					vx: Math.cos(angle) * speed,
					vy: Math.sin(angle) * speed - 2.6,
					size: Math.random() * 8 + 4.5,
					color: this.paletteColors[
						Math.floor(Math.random() * this.paletteColors.length)
					],
					alpha: 1,
					decay: Math.random() * 0.012 + 0.006,
					rotation: Math.random() * Math.PI * 2,
					vRot: (Math.random() - 0.5) * 0.18,
					shape: type === "mix" ? this.pickMixShape() : type,
				});
			}
		}

		private drawStar(
			cx: number,
			cy: number,
			spikes: number,
			outerRadius: number,
			innerRadius: number,
		) {
			let rot = (Math.PI / 2) * 3;
			let x = cx;
			let y = cy;
			const step = Math.PI / spikes;
			this.ctx.beginPath();
			this.ctx.moveTo(cx, cy - outerRadius);
			for (let i = 0; i < spikes; i++) {
				x = cx + Math.cos(rot) * outerRadius;
				y = cy + Math.sin(rot) * outerRadius;
				this.ctx.lineTo(x, y);
				rot += step;
				x = cx + Math.cos(rot) * innerRadius;
				y = cy + Math.sin(rot) * innerRadius;
				this.ctx.lineTo(x, y);
				rot += step;
			}
			this.ctx.lineTo(cx, cy - outerRadius);
			this.ctx.closePath();
			this.ctx.fill();
		}

		private animateParticles = () => {
			this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

			if (Math.random() < 0.08 && this.particles.length < 60) {
				this.particles.push({
					x: Math.random() * this.canvas.width,
					y: this.canvas.height + 10,
					vx: (Math.random() - 0.5) * 0.6,
					vy: -Math.random() * 1.2 - 0.5,
					size: Math.random() * 4 + 2,
					color: "#CDB37B",
					alpha: 0.7,
					decay: 0.003,
					rotation: 0,
					vRot: 0.02,
					shape: "circle",
				});
			}

			for (let i = this.particles.length - 1; i >= 0; i--) {
				const p = this.particles[i];
				p.x += p.vx;
				p.y += p.vy;
				p.vy += 0.09;
				p.alpha -= p.decay;
				p.rotation += p.vRot;

				if (p.alpha <= 0) {
					this.particles.splice(i, 1);
					continue;
				}

				this.ctx.save();
				this.ctx.globalAlpha = Math.max(0, p.alpha);
				this.ctx.fillStyle = p.color;
				this.ctx.translate(p.x, p.y);
				this.ctx.rotate(p.rotation);

				if (p.shape === "star") {
					this.drawStar(0, 0, 5, p.size, p.size / 2.2);
				} else if (p.shape === "heart") {
					const s = p.size * 0.12;
					this.ctx.beginPath();
					this.ctx.moveTo(0, 3 * s);
					this.ctx.bezierCurveTo(0, 0, -5 * s, 0, -5 * s, 3 * s);
					this.ctx.bezierCurveTo(-5 * s, 6 * s, 0, 8 * s, 0, 11 * s);
					this.ctx.bezierCurveTo(
						0,
						8 * s,
						5 * s,
						6 * s,
						5 * s,
						3 * s,
					);
					this.ctx.bezierCurveTo(5 * s, 0, 0, 0, 0, 3 * s);
					this.ctx.fill();
				} else if (p.shape === "confetti") {
					const w = p.size * 1.4;
					const h =
						p.size *
						0.65 *
						Math.max(0.25, Math.abs(Math.cos(p.rotation * 2)));
					this.ctx.fillRect(-w / 2, -h / 2, w, h);
				} else {
					this.ctx.beginPath();
					this.ctx.arc(0, 0, p.size / 1.6, 0, Math.PI * 2);
					this.ctx.fill();
				}
				this.ctx.restore();
			}

			this.animationFrameId = requestAnimationFrame(
				this.animateParticles,
			);
		};
	}

	if (!customElements.get("sparkle-canvas")) {
		customElements.define("sparkle-canvas", SparkleCanvasElement);
	}
</script>
