				<path d="M180 428 L196 496" stroke="#DCB4B7" stroke-width="2" stroke-linecap="round"></path>
				<!-- Bodice & Sleeves -->
				<path d="M146 402 L186 402 L190 426 L142 426 Z" fill="#E6C0CF"></path>
				<ellipse cx="142" cy="410" rx="9" ry="6" transform="rotate(-25 142 410)" fill="#E6C0CF"></ellipse>
				<ellipse cx="190" cy="410" rx="9" ry="6" transform="rotate(25 190 410)" fill="#E6C0CF"></ellipse>
				<!-- Gold Waist Belt -->
				<rect x="143" y="421" width="46" height="6" rx="3" fill="url(#goldGrad)"></rect>

				<!-- Arms -->
				<path d="M138 412 L118 434" stroke="#F2F8F6" stroke-width="9" stroke-linecap="round"></path>
				<path d="M194 412 L214 442" stroke="#F2F8F6" stroke-width="9" stroke-linecap="round"></path>

				<!-- Interactive Golden Star Wand in Her Right Hand -->
				<g id="fairy-wand-svg">
					<line x1="134" y1="452" x2="102" y2="394" stroke="url(#goldGrad)" stroke-width="3.5" stroke-linecap="round"></line>
					<!-- 5-Point Puffy Gold Star -->
					<polygon
						points="102,374 107,386 120,387 110,396 113,408 102,401 91,408 94,396 84,387 97,386"
						fill="url(#goldSphere)"
						stroke="#b39252"
						stroke-width="1"></polygon>
