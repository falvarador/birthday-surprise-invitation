</birthday-cake>

<script>
	import { partyState, createParticles, emitPartyEvent, showToast } from '../scripts/partyStore';
	import {
		playSparkleChime,
		playCandleBlowSound,
		playDoorCreakChime,
		playHappyBirthdayMelody,
	} from '../scripts/audioManager';

	class BirthdayCakeElement extends HTMLElement {
		private triggerMagicWand = () => {
			const wand = this.querySelector('#fairy-wand-svg') as HTMLElement | SVGElement | null;
			if (wand) {
				wand.classList.remove('wand-active');
				void wand.getBoundingClientRect();
				wand.classList.add('wand-active');
			}

			playSparkleChime();
			const svgEl = this.querySelector('#birthday-cake-svg');
			if (svgEl) {
				const svgRect = svgEl.getBoundingClientRect();
				const wandX = svgRect.left + svgRect.width * 0.22;
				const wandY = svgRect.top + svgRect.height * 0.64;
				createParticles(wandX, wandY, 35);
			}
			showToast(`${partyState.name}'s fairy wand cast a magical birthday wish!`);
		};

		private blowCandle = (index: number) => {
			if (!partyState.candlesLit[index]) return;
			partyState.candlesLit[index] = false;
			const flameEl = this.querySelector(`#flame-${index}`) as HTMLElement | SVGElement | null;
			if (flameEl) {
				flameEl.style.transition = 'opacity 0.35s ease, transform 0.35s ease';
				flameEl.style.opacity = '0';
				flameEl.style.transform = 'scale(0.1)';
			}

			playCandleBlowSound();
			const svgEl = this.querySelector('#birthday-cake-svg');
			if (svgEl) {
				const svgRect = svgEl.getBoundingClientRect();
				createParticles(svgRect.left + svgRect.width * 0.43, svgRect.top + svgRect.height * 0.14, 22);
			}

			this.checkAllCandlesBlown();
		};

		private blowAllCandles = () => {
			let anyLit = false;
			([0, 1, 2] as const).forEach((idx, delayIdx) => {
				if (partyState.candlesLit[idx]) {
					anyLit = true;
					setTimeout(() => this.blowCandle(idx), delayIdx * 180);
				}
			});
			if (!anyLit) {
				showToast(`All candles are out! Tap Door #${partyState.age} or Relight Candles.`);
			}
		};

		private checkAllCandlesBlown() {
			const allOut = partyState.candlesLit.every((lit) => !lit);
			if (allOut && partyState.step === 1) {
				partyState.step = 2;
				playHappyBirthdayMelody();

				const doorPanel = this.querySelector('#cake-door-panel');
				doorPanel?.classList.add('door-ready');

				const bubbleText = this.querySelector('#bubble-text');
				if (bubbleText) {
					bubbleText.textContent = `Tap the glowing Door #${partyState.age} to open it! 🚪✨`;
				}

				emitPartyEvent('party:step-changed');
				showToast(`Yay! Make a wish! Now tap Door #${partyState.age} on the cake!`);
			}
		}

		private toggleCakeDoor = () => {
			const doorPanel = this.querySelector('#cake-door-panel');
			const bubbleText = this.querySelector('#bubble-text');
			partyState.doorOpen = !partyState.doorOpen;

			if (partyState.doorOpen) {
				doorPanel?.classList.remove('door-ready');
				doorPanel?.classList.add('door-open');
				playDoorCreakChime();

				const svgEl = this.querySelector('#birthday-cake-svg');
				if (svgEl) {
					const svgRect = svgEl.getBoundingClientRect();
					createParticles(svgRect.left + svgRect.width * 0.58, svgRect.top + svgRect.height * 0.68, 45);
				}

				partyState.step = 3;
				if (bubbleText) {
					bubbleText.textContent = 'Tap inside the open door for your surprise card! 💌';
				}
				emitPartyEvent('party:step-changed');

				setTimeout(() => {
					emitPartyEvent('party:open-invitation');
				}, 1150);
			} else {
				doorPanel?.classList.remove('door-open');
				playSparkleChime();
				if (bubbleText) {
					bubbleText.textContent = `Tap Door #${partyState.age} anytime to peek inside!`;
				}
			}
		};

		private resetCakeExperience = () => {
			partyState.candlesLit = [true, true, true];
			partyState.doorOpen = false;
			partyState.step = 1;

			([0, 1, 2] as const).forEach((idx) => {
				const flameEl = this.querySelector(`#flame-${idx}`) as HTMLElement | SVGElement | null;
				if (flameEl) {
					flameEl.style.opacity = '1';
					flameEl.style.transform = 'scale(1)';
				}
			});

			const doorPanel = this.querySelector('#cake-door-panel');
			doorPanel?.classList.remove('door-open', 'door-ready');

			const bubbleText = this.querySelector('#bubble-text');
			if (bubbleText) {
				bubbleText.textContent = "Tap the glowing castle candles or the fairy's star wand!";
			}

			emitPartyEvent('party:step-changed');
			playSparkleChime();
			showToast('Candles relit! Ready to make another birthday wish!');
		};

		connectedCallback() {
			this.querySelectorAll('[data-candle]').forEach((candleGroup) => {
				candleGroup.addEventListener('click', () => {
					const idx = Number(candleGroup.getAttribute('data-candle'));
					if (!Number.isNaN(idx)) this.blowCandle(idx);
				});
			});

			this.querySelectorAll('[data-cake-action="wand"]').forEach((el) => {
				el.addEventListener('click', this.triggerMagicWand);
			});

			this.querySelectorAll('[data-cake-action="open-invitation"]').forEach((el) => {
				el.addEventListener('click', () => emitPartyEvent('party:open-invitation'));
			});

			this.querySelectorAll('[data-cake-action="toggle-door"]').forEach((el) => {
				el.addEventListener('click', this.toggleCakeDoor);
			});

			window.addEventListener('party:wand-burst', this.triggerMagicWand);
			window.addEventListener('party:blow-all-candles', this.blowAllCandles);
			window.addEventListener('party:toggle-door', this.toggleCakeDoor);
			window.addEventListener('party:reset-cake', this.resetCakeExperience);
		}

		disconnectedCallback() {
			window.removeEventListener('party:wand-burst', this.triggerMagicWand);
			window.removeEventListener('party:blow-all-candles', this.blowAllCandles);
			window.removeEventListener('party:toggle-door', this.toggleCakeDoor);
			window.removeEventListener('party:reset-cake', this.resetCakeExperience);
		}
	}

	if (!customElements.get('birthday-cake')) {
		customElements.define('birthday-cake', BirthdayCakeElement);
	}
</script>
