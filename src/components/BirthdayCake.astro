				<!-- Doll Head -->
				<circle cx="166" cy="378" r="31" fill="#F2F8F6"></circle>
				<!-- Rosy Cheeks -->
				<ellipse cx="149" cy="385" rx="5.5" ry="3.5" fill="#E6C0CF" opacity="0.8"></ellipse>
				<ellipse cx="183" cy="385" rx="5.5" ry="3.5" fill="#E6C0CF" opacity="0.8"></ellipse>
