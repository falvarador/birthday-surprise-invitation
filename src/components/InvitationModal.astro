<invitation-modal class="contents">
	<div
		id="invitation-modal"
		role="dialog"
		aria-modal="true"
		aria-labelledby="invitation-modal-title"
		class="fixed inset-0 z-50 hidden items-center justify-center p-2 sm:p-4 bg-palette-brown/60 backdrop-blur-md overflow-hidden"
	>
		<div
			class="relative w-full max-w-2xl max-h-[96dvh] overflow-hidden bg-palette-mint rounded-3xl p-2.5 sm:p-5 shadow-2xl border-4 border-palette-pink my-auto"
		>
			<!-- Close button -->
			<button
				type="button"
				data-action="close-modal"
				aria-label="Volver al pastel"
				class="absolute top-3.5 right-3.5 sm:top-5 sm:right-5 z-10 w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-white hover:bg-palette-pink/50 text-palette-brown font-bold shadow-sm flex items-center justify-center border border-palette-pink transition-all active:scale-95 cursor-pointer"
			>
				✕
			</button>

			<!-- Inner ornate gold frame -->
			<div
				class="bg-white rounded-2xl p-3 sm:p-5 border-2 border-palette-gold/70 shadow-inner text-center relative overflow-hidden"
			>
				<!-- Subtle floral corners -->
				<div
					class="absolute -top-6 -left-6 w-20 h-20 rounded-full bg-palette-pink/30"
					aria-hidden="true"
				>
				</div>
				<div
					class="absolute -bottom-6 -right-6 w-20 h-20 rounded-full bg-palette-pink/30"
					aria-hidden="true"
				>
				</div>

				<!-- Header Badge -->
				<div
					class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full bg-palette-mint border border-palette-gold/50 text-xs font-bold uppercase tracking-widest text-palette-brown mb-1"
				>
					<span aria-hidden="true">🧚‍♀️</span> Celebración real <span
						aria-hidden="true">🏰</span
					>
				</div>

				<h2
					id="invitation-modal-title"
					class="font-script text-3xl sm:text-4xl lg:text-5xl text-palette-brown leading-tight mb-0.5"
				>
					Acompáñanos a celebrar
				</h2>
				<h3
					class="font-serif italic font-bold text-2xl sm:text-3xl lg:text-4xl gold-shimmer leading-tight mb-2 sm:mb-3"
				>
					¡La Princesa <span class="dynamic-name">Sofía</span> cumple <span
						class="dynamic-age">4</span
					> años!
				</h3>

				<!-- Special Surprise Note Box for Daughter -->
				<div
					class="bg-palette-mint/90 rounded-2xl p-2.5 sm:p-3.5 border border-palette-pink mb-2 sm:mb-3.5 max-w-lg mx-auto shadow-xs"
				>
					<p
						class="text-xs font-bold uppercase tracking-wider text-palette-gold mb-0.5"
					>
						💖 Mensaje especial de cumpleaños 💖
					</p>
					<p
						id="card-surprise-message"
						class="font-serif italic text-xl sm:text-2xl text-palette-brown leading-snug"
					>
						"¡Ponte tu vestido de princesa favorito, piquito! ¡Tus
						mejores amigos, familiares y este pastel de castillo de
						hadas te están esperando solo a ti!"
					</p>
				</div>

				<!-- Countdown timer web component -->
				<countdown-timer
					class="grid grid-cols-4 gap-1.5 sm:gap-2.5 max-w-md mx-auto mb-2 sm:mb-3.5"
				>
					<div
						class="bg-palette-gray rounded-xl py-1.5 px-2 sm:p-2 border border-palette-pink/60"
					>
						<div
							id="cd-days"
							class="text-2xl sm:text-3xl font-bold text-palette-brown leading-tight"
						>
							00
						</div>
						<div
							class="text-xs uppercase tracking-wider font-semibold text-palette-brown/70"
						>
							Días
						</div>
					</div>
					<div
						class="bg-palette-gray rounded-xl py-1.5 px-2 sm:p-2 border border-palette-pink/60"
					>
						<div
							id="cd-hours"
							class="text-2xl sm:text-3xl font-bold text-palette-brown leading-tight"
						>
							00
						</div>
						<div
							class="text-xs uppercase tracking-wider font-semibold text-palette-brown/70"
						>
							Horas
						</div>
					</div>
					<div
						class="bg-palette-gray rounded-xl py-1.5 px-2 sm:p-2 border border-palette-pink/60"
					>
						<div
							id="cd-mins"
							class="text-2xl sm:text-3xl font-bold text-palette-brown leading-tight"
						>
							00
						</div>
						<div
							class="text-xs uppercase tracking-wider font-semibold text-palette-brown/70"
						>
							Mins
						</div>
					</div>
					<div
						class="bg-palette-gray rounded-xl py-1.5 px-2 sm:p-2 border border-palette-pink/60"
					>
						<div
							id="cd-secs"
							class="text-2xl sm:text-3xl font-bold text-palette-brown leading-tight"
						>
							00
						</div>
						<div
							class="text-xs uppercase tracking-wider font-semibold text-palette-brown/70"
						>
							Segs
						</div>
					</div>
				</countdown-timer>

				<!-- Event details grid -->
				<div
					class="grid grid-cols-2 sm:grid-cols-3 gap-1.5 sm:gap-2.5 text-left mb-2 sm:mb-3.5"
				>
					<div
						class="bg-palette-mint/60 p-2 sm:p-3 rounded-2xl border border-palette-pink/60 flex items-start gap-2"
					>
						<span
							class="text-lg sm:text-xl leading-none mt-0.5"
							aria-hidden="true">📅</span
						>
						<div class="min-w-0">
							<div
								class="text-xs font-bold uppercase tracking-wider text-palette-gold leading-tight"
							>
								Fecha
							</div>
							<div
								id="card-date-display"
								class="text-base font-bold text-palette-brown leading-snug"
							>
								Sábado, 14 de nov de 2026
							</div>
						</div>
					</div>
					<div
						class="bg-palette-mint/60 p-2 sm:p-3 rounded-2xl border border-palette-pink/60 flex items-start gap-2"
					>
						<span
							class="text-lg sm:text-xl leading-none mt-0.5"
							aria-hidden="true">⏰</span
						>
						<div class="min-w-0">
							<div
								class="text-xs font-bold uppercase tracking-wider text-palette-gold leading-tight"
							>
								Hora
							</div>
							<div
								id="card-time-display"
								class="text-base font-bold text-palette-brown leading-snug"
							>
								3:00 PM – 6:30 PM
							</div>
						</div>
					</div>
					<div
						class="col-span-2 sm:col-span-1 bg-palette-mint/60 p-2 sm:p-3 rounded-2xl border border-palette-pink/60 flex items-start gap-2"
					>
						<span
							class="text-lg sm:text-xl leading-none mt-0.5"
							aria-hidden="true">📍</span
						>
						<div class="min-w-0">
							<div
								class="text-xs font-bold uppercase tracking-wider text-palette-gold leading-tight"
							>
								Lugar
							</div>
							<div
								id="card-venue-display"
								class="text-base font-bold text-palette-brown leading-snug"
							>
								Casa Club, Condominio Uniko San Francisco
							</div>
						</div>
					</div>
				</div>

				<!-- Dress Code & Theme Pill -->
				<div
					class="inline-block bg-palette-pink/35 px-3.5 py-1 rounded-2xl sm:rounded-full text-base font-semibold text-palette-brown mb-2.5 sm:mb-3.5"
				>
					👗 <strong>Código de Vestimenta:</strong>
					<span id="card-dress-display" class="text-base"
						>Ropa fresca y relajada</span
					>
				</div>

				<!-- Simplified Footer Actions (Celebrate with Confetti & Close / Back to Cake) -->
				<div
					class="grid grid-cols-2 sm:flex sm:flex-wrap items-center justify-center gap-2 sm:gap-3 pt-2 sm:pt-3 border-t border-palette-gray"
				>
					<button
						type="button"
						data-action="celebrate"
						class="w-full sm:w-auto justify-center py-2 sm:py-2.5 px-3 sm:px-6 rounded-xl gold-badge text-white font-bold text-sm shadow-md hover:brightness-105 active:scale-95 transition-all flex items-center gap-1.5 sm:gap-2 cursor-pointer"
					>
						<span aria-hidden="true">🎊</span>
						<span>Celebrar con Confeti</span>
					</button>
					<button
						type="button"
						data-action="close-modal"
						class="w-full sm:w-auto justify-center py-2 sm:py-2.5 px-3 sm:px-6 rounded-xl bg-palette-gray hover:bg-palette-pink/40 text-palette-brown font-bold text-sm border border-palette-rose/60 transition-all flex items-center gap-1.5 sm:gap-2 active:scale-95 cursor-pointer"
					>
						<span aria-hidden="true">🎂</span>
						<span>Volver al Pastel</span>
					</button>
				</div>
			</div>
		</div>
	</div>
</invitation-modal>

<script>
	import { partyState, formatReadableDate } from "../scripts/partyStore";
	import { celebrateGrandFinale } from "../scripts/audioManager";

	class CountdownTimerElement extends HTMLElement {
		private intervalId: number | undefined;

		private updateCountdown = () => {
			const [year, month, day] = partyState.dateISO
				.split("-")
				.map(Number);
			const target = new Date(year, month - 1, day, 15, 0, 0).getTime();
			const now = Date.now();
			const diff = Math.max(0, target - now);

			const days = Math.floor(diff / (1000 * 60 * 60 * 24));
			const hours = Math.floor(
				(diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60),
			);
			const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
			const secs = Math.floor((diff % (1000 * 60)) / 1000);

			const daysEl = this.querySelector("#cd-days");
			const hoursEl = this.querySelector("#cd-hours");
			const minsEl = this.querySelector("#cd-mins");
			const secsEl = this.querySelector("#cd-secs");

			if (daysEl) daysEl.textContent = String(days).padStart(2, "0");
			if (hoursEl) hoursEl.textContent = String(hours).padStart(2, "0");
			if (minsEl) minsEl.textContent = String(mins).padStart(2, "0");
			if (secsEl) secsEl.textContent = String(secs).padStart(2, "0");
		};

		connectedCallback() {
			this.updateCountdown();
			this.intervalId = window.setInterval(this.updateCountdown, 1000);
			window.addEventListener("party:updated", this.updateCountdown);
		}

		disconnectedCallback() {
			window.clearInterval(this.intervalId);
			window.removeEventListener("party:updated", this.updateCountdown);
		}
	}

	class InvitationModalElement extends HTMLElement {
		private openModal = () => {
			const modal = this.querySelector("#invitation-modal");
			modal?.classList.remove("hidden");
			modal?.classList.add("flex");
			celebrateGrandFinale();
		};

		private closeModal = () => {
			const modal = this.querySelector("#invitation-modal");
			modal?.classList.add("hidden");
			modal?.classList.remove("flex");
		};

		private syncCardDetails = () => {
			const dateEl = this.querySelector("#card-date-display");
			const timeEl = this.querySelector("#card-time-display");
			const venueEl = this.querySelector("#card-venue-display");
			const dressEl = this.querySelector("#card-dress-display");
			const surpriseEl = this.querySelector("#card-surprise-message");

			if (dateEl)
				dateEl.textContent = formatReadableDate(partyState.dateISO);
			if (timeEl) timeEl.textContent = partyState.timeText;
			if (venueEl) venueEl.textContent = partyState.venue;
			if (dressEl) dressEl.textContent = partyState.dressCode;
			if (surpriseEl) surpriseEl.textContent = partyState.surpriseMessage;
		};

		connectedCallback() {
			this.syncCardDetails();

			this.querySelectorAll('[data-action="close-modal"]').forEach(
				(btn) => {
					btn.addEventListener("click", this.closeModal);
				},
			);

			this.querySelector('[data-action="celebrate"]')?.addEventListener(
				"click",
				celebrateGrandFinale,
			);

			// Close on backdrop click
			const modal = this.querySelector("#invitation-modal");
			modal?.addEventListener("click", (e) => {
				if (e.target === modal) this.closeModal();
			});

			window.addEventListener("party:open-invitation", this.openModal);
			window.addEventListener("party:updated", this.syncCardDetails);
		}

		disconnectedCallback() {
			window.removeEventListener("party:open-invitation", this.openModal);
			window.removeEventListener("party:updated", this.syncCardDetails);
		}
	}

	if (!customElements.get("countdown-timer")) {
		customElements.define("countdown-timer", CountdownTimerElement);
	}
	if (!customElements.get("invitation-modal")) {
		customElements.define("invitation-modal", InvitationModalElement);
	}
</script>
