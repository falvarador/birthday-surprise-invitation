<invitation-modal class="contents">
	<div
		id="invitation-modal"
		role="dialog"
		aria-modal="true"
		aria-labelledby="invitation-modal-title"
		class="fixed inset-0 z-50 hidden items-center justify-center p-3 sm:p-6 bg-palette-brown/60 backdrop-blur-md overflow-y-auto"
	>
		<div
			class="relative w-full max-w-2xl bg-palette-mint rounded-3xl p-4 sm:p-8 shadow-2xl border-4 border-palette-pink my-auto animate-float-reverse"
		>
			<!-- Close Button -->
			<button
				type="button"
				data-action="close-modal"
				aria-label="Volver al pastel"
				class="absolute top-4 right-4 z-10 w-10 h-10 rounded-full bg-white hover:bg-palette-pink/50 text-palette-brown font-bold shadow-sm flex items-center justify-center border border-palette-pink transition-all active:scale-95 cursor-pointer"
			>
				✕
			</button>

			<!-- Inner Ornate Gold Frame -->
			<div
				class="bg-white rounded-2xl p-5 sm:p-8 border-2 border-palette-gold/70 shadow-inner text-center relative overflow-hidden"
			>
				<!-- Subtle floral corners -->
				<div
					class="absolute -top-6 -left-6 w-20 h-20 rounded-full bg-palette-pink/30"
					aria-hidden="true"
				>
				</div>
				<div
					class="absolute -bottom-6 -right-6 w-20 h-20 rounded-full bg-palette-pink/30"
					aria-hidden="true"
				>
				</div>

				<!-- Header Badge -->
				<div
					class="inline-flex items-center gap-2 px-4 py-1 rounded-full bg-palette-mint border border-palette-gold/50 text-xs font-bold uppercase tracking-widest text-palette-brown mb-2"
				>
					<span aria-hidden="true">🧚‍♀️</span> Celebración real de cuento
					de hadas <span aria-hidden="true">🏰</span>
				</div>

				<h2
					id="invitation-modal-title"
					class="font-script text-4xl sm:text-5xl text-palette-brown mb-1"
				>
					Acompáñanos a celebrar
				</h2>
				<h3
					class="font-serif italic font-bold text-3xl sm:text-4xl gold-shimmer mb-4"
				>
					¡La Princesa <span class="dynamic-name">Sofía</span> cumple <span
						class="dynamic-age">4</span
					> años!
				</h3>

				<!-- Special Surprise Note Box for Daughter -->
				<div
					class="bg-palette-mint/90 rounded-2xl p-4 border border-palette-pink mb-5 max-w-lg mx-auto shadow-xs"
				>
					<p
						class="text-xs font-bold uppercase tracking-wider text-palette-gold mb-1"
					>
						💖 Mensaje especial de cumpleaños 💖
					</p>
					<p
						id="card-surprise-message"
						class="font-serif italic text-lg sm:text-xl text-palette-brown leading-snug"
					>
						"¡Ponte tu vestido de princesa favorito, piquito! ¡Tus
						mejores amigos, familiares, seres queridos y este pastel
						de castillo de hadas te están esperando solo a ti!"
					</p>
				</div>

				<!-- Countdown Timer Web Component -->
				<countdown-timer
					class="grid grid-cols-4 gap-2 sm:gap-3 max-w-md mx-auto mb-6"
				>
					<div
						class="bg-palette-gray rounded-xl p-2.5 border border-palette-pink/60"
					>
						<div
							id="cd-days"
							class="text-xl sm:text-2xl font-bold text-palette-brown"
						>
							00
						</div>
						<div
							class="text-[10px] uppercase tracking-wider font-semibold text-palette-brown/70"
						>
							Días
						</div>
					</div>
					<div
						class="bg-palette-gray rounded-xl p-2.5 border border-palette-pink/60"
					>
						<div
							id="cd-hours"
							class="text-xl sm:text-2xl font-bold text-palette-brown"
						>
							00
						</div>
						<div
							class="text-[10px] uppercase tracking-wider font-semibold text-palette-brown/70"
						>
							Horas
						</div>
					</div>
					<div
						class="bg-palette-gray rounded-xl p-2.5 border border-palette-pink/60"
					>
						<div
							id="cd-mins"
							class="text-xl sm:text-2xl font-bold text-palette-brown"
						>
							00
						</div>
						<div
							class="text-[10px] uppercase tracking-wider font-semibold text-palette-brown/70"
						>
							Mins
						</div>
					</div>
					<div
						class="bg-palette-gray rounded-xl p-2.5 border border-palette-pink/60"
					>
						<div
							id="cd-secs"
							class="text-xl sm:text-2xl font-bold text-palette-brown"
						>
							00
						</div>
						<div
							class="text-[10px] uppercase tracking-wider font-semibold text-palette-brown/70"
						>
							Segs
						</div>
					</div>
				</countdown-timer>

				<!-- Event Details Grid -->
				<div
					class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-left mb-6"
				>
					<div
						class="bg-palette-mint/60 p-3.5 rounded-2xl border border-palette-pink/60 flex items-start gap-3"
					>
						<span class="text-2xl" aria-hidden="true">📅</span>
						<div>
							<div
								class="text-[11px] font-bold uppercase tracking-wider text-palette-gold"
							>
								Fecha
							</div>
							<div
								id="card-date-display"
								class="text-sm font-bold text-palette-brown"
							>
								sábado, 14 de nov de 2026
							</div>
						</div>
					</div>
					<div
						class="bg-palette-mint/60 p-3.5 rounded-2xl border border-palette-pink/60 flex items-start gap-3"
					>
						<span class="text-2xl" aria-hidden="true">⏰</span>
						<div>
							<div
								class="text-[11px] font-bold uppercase tracking-wider text-palette-gold"
							>
								Hora
							</div>
							<div
								id="card-time-display"
								class="text-sm font-bold text-palette-brown"
							>
								3:00 PM – 6:30 PM
							</div>
						</div>
					</div>
					<div
						class="bg-palette-mint/60 p-3.5 rounded-2xl border border-palette-pink/60 flex items-start gap-3"
					>
						<span class="text-2xl" aria-hidden="true">📍</span>
						<div>
							<div
								class="text-[11px] font-bold uppercase tracking-wider text-palette-gold"
							>
								Lugar
							</div>
							<div
								id="card-venue-display"
								class="text-sm font-bold text-palette-brown"
							>
								Casa Club, Condominio Uniko San Francisco
							</div>
						</div>
					</div>
				</div>

				<!-- Dress Code & Theme Pill -->
				<div
					class="inline-block bg-palette-pink/35 px-4 py-1.5 rounded-full text-xs font-semibold text-palette-brown mb-6"
				>
					👗 <strong>Código de Vestimenta:</strong>
					<span id="card-dress-display"
						>Rosa Pastel, Crema y un Toque de Dorado</span
					>
				</div>

				<!-- Interactive RSVP & Share Actions -->
				<div
					class="flex flex-wrap items-center justify-center gap-3 pt-2 border-t border-palette-gray"
				>
					<button
						type="button"
						data-action="toggle-rsvp"
						class="py-3 px-6 rounded-xl gold-badge text-white font-bold text-sm shadow-md hover:brightness-105 active:scale-95 transition-all flex items-center gap-2 cursor-pointer"
					>
						<span aria-hidden="true">🎉</span>
						<span>Deja un Deseo / Confirmar Asistencia</span>
					</button>
					<button
						type="button"
						data-action="copy-invite"
						class="py-3 px-5 rounded-xl bg-palette-gray hover:bg-palette-pink/40 text-palette-brown font-bold text-sm border border-palette-rose/60 transition-all flex items-center gap-2 active:scale-95 cursor-pointer"
					>
						<span aria-hidden="true">📋</span>
						<span id="copy-btn-label">Copiar Detalles</span>
					</button>
					<button
						type="button"
						data-action="celebrate"
						class="py-3 px-5 rounded-xl bg-palette-pink/50 hover:bg-palette-pink text-palette-brown font-bold text-sm transition-all flex items-center gap-2 active:scale-95 cursor-pointer"
					>
						<span aria-hidden="true">🎊</span>
						<span>¡Lluvia de Confeti!</span>
					</button>
				</div>

				<!-- Collapsible RSVP / Birthday Wish Wall Web Component -->
				<rsvp-wall class="block">
					<div
						id="rsvp-drawer"
						class="hidden mt-5 pt-5 border-t border-palette-pink text-left"
					>
						<h4
							class="font-bold text-sm text-palette-brown mb-3 flex items-center gap-1.5"
						>
							<span aria-hidden="true">💌</span> Enviar un Deseo Real
							o Confirmar Asistencia
						</h4>
						<form
							id="rsvp-form"
							class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4"
						>
							<input
								id="rsvp-guest-name"
								type="text"
								required
								placeholder="Tu Nombre (ej., Tía Sofía)"
								aria-label="Tu Nombre"
								class="px-3.5 py-2.5 rounded-xl bg-palette-mint border border-palette-pink text-sm text-palette-brown focus:outline-none focus:border-palette-gold"
							/>
							<select
								id="rsvp-attendance"
								aria-label="Estado de Asistencia"
								class="px-3.5 py-2.5 rounded-xl bg-palette-mint border border-palette-pink text-sm text-palette-brown focus:outline-none focus:border-palette-gold"
							>
								<option value="attending"
									>✨ ¡Asistiremos con alegría!</option
								>
								<option value="wishes"
									>💖 Enviando cálidos deseos desde lejos</option
								>
							</select>
							<input
								id="rsvp-wish-text"
								type="text"
								required
								placeholder="Escribe un dulce mensaje de cumpleaños para la princesa..."
								aria-label="Mensaje de Cumpleaños"
								class="sm:col-span-2 px-3.5 py-2.5 rounded-xl bg-palette-mint border border-palette-pink text-sm text-palette-brown focus:outline-none focus:border-palette-gold"
							/>
							<button
								type="submit"
								class="sm:col-span-2 py-2.5 rounded-xl bg-palette-brown hover:bg-palette-darkBrown text-white font-bold text-sm transition-all cursor-pointer"
							>
								Publicar Deseo de Cumpleaños ✨
							</button>
						</form>
						<div
							id="wishes-list"
							class="space-y-2 max-h-36 overflow-y-auto pr-1"
						>
						</div>
					</div>
				</rsvp-wall>
			</div>
		</div>
	</div>
</invitation-modal>

<script>
	import {
		partyState,
		formatReadableDate,
		createParticles,
		showToast,
	} from "../scripts/partyStore";
	import {
		playSparkleChime,
		celebrateGrandFinale,
	} from "../scripts/audioManager";

	class CountdownTimerElement extends HTMLElement {
		private intervalId: number | undefined;

		private updateCountdown = () => {
			const [year, month, day] = partyState.dateISO
				.split("-")
				.map(Number);
			const target = new Date(year, month - 1, day, 15, 0, 0).getTime();
			const now = Date.now();
			const diff = Math.max(0, target - now);

			const days = Math.floor(diff / (1000 * 60 * 60 * 24));
			const hours = Math.floor(
				(diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60),
			);
			const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
			const secs = Math.floor((diff % (1000 * 60)) / 1000);

			const daysEl = this.querySelector("#cd-days");
			const hoursEl = this.querySelector("#cd-hours");
			const minsEl = this.querySelector("#cd-mins");
			const secsEl = this.querySelector("#cd-secs");

			if (daysEl) daysEl.textContent = String(days).padStart(2, "0");
			if (hoursEl) hoursEl.textContent = String(hours).padStart(2, "0");
			if (minsEl) minsEl.textContent = String(mins).padStart(2, "0");
			if (secsEl) secsEl.textContent = String(secs).padStart(2, "0");
		};

		connectedCallback() {
			this.updateCountdown();
			this.intervalId = window.setInterval(this.updateCountdown, 1000);
			window.addEventListener("party:updated", this.updateCountdown);
		}

		disconnectedCallback() {
			window.clearInterval(this.intervalId);
			window.removeEventListener("party:updated", this.updateCountdown);
		}
	}

	class RsvpWallElement extends HTMLElement {
		public toggleDrawer() {
			const drawer = this.querySelector("#rsvp-drawer");
			drawer?.classList.toggle("hidden");
			this.renderWishesList();
		}

		public renderWishesList() {
			const container = this.querySelector("#wishes-list");
			if (!container) return;
			container.innerHTML = partyState.wishes
				.map(
					(w) => `
				<div class="bg-palette-mint p-3 rounded-xl border border-palette-pink/70 text-xs">
					<div class="flex items-center justify-between font-bold text-palette-brown mb-0.5">
						<span>👑 ${w.name}</span>
						<span class="text-[10px] text-palette-gold">${w.status}</span>
					</div>
					<p class="text-palette-brown/85 italic">"${w.text}"</p>
				</div>
			`,
				)
				.join("");
		}

		connectedCallback() {
			this.renderWishesList();
			const form = this.querySelector(
				"#rsvp-form",
			) as HTMLFormElement | null;
			form?.addEventListener("submit", (event) => {
				event.preventDefault();
				const nameInput = this.querySelector(
					"#rsvp-guest-name",
				) as HTMLInputElement | null;
				const attendanceSelect = this.querySelector(
					"#rsvp-attendance",
				) as HTMLSelectElement | null;
				const wishInput = this.querySelector(
					"#rsvp-wish-text",
				) as HTMLInputElement | null;

				const guestName = nameInput?.value.trim() || "";
				const statusText =
					attendanceSelect?.options[attendanceSelect.selectedIndex]
						?.text || "✨ ¡Asistiremos con alegría!";
				const wishText = wishInput?.value.trim() || "";

				if (!guestName || !wishText) return;

				partyState.wishes.unshift({
					name: guestName,
					status: statusText,
					text: wishText,
				});

				if (nameInput) nameInput.value = "";
				if (wishInput) wishInput.value = "";
				this.renderWishesList();
				playSparkleChime();
				createParticles(
					window.innerWidth / 2,
					window.innerHeight / 2,
					30,
				);
				showToast(
					`¡Gracias, ${guestName}! ¡Se añadió tu deseo de cumpleaños!`,
				);
			});
		}
	}

	class InvitationModalElement extends HTMLElement {
		private openModal = () => {
			const modal = this.querySelector("#invitation-modal");
			modal?.classList.remove("hidden");
			modal?.classList.add("flex");
			celebrateGrandFinale();
		};

		private closeModal = () => {
			const modal = this.querySelector("#invitation-modal");
			modal?.classList.add("hidden");
			modal?.classList.remove("flex");
		};

		private syncCardDetails = () => {
			const dateEl = this.querySelector("#card-date-display");
			const timeEl = this.querySelector("#card-time-display");
			const venueEl = this.querySelector("#card-venue-display");
			const dressEl = this.querySelector("#card-dress-display");
			const surpriseEl = this.querySelector("#card-surprise-message");

			if (dateEl)
				dateEl.textContent = formatReadableDate(partyState.dateISO);
			if (timeEl) timeEl.textContent = partyState.timeText;
			if (venueEl) venueEl.textContent = partyState.venue;
			if (dressEl) dressEl.textContent = partyState.dressCode;
			if (surpriseEl) surpriseEl.textContent = partyState.surpriseMessage;
		};

		private copyInvitationText = async () => {
			const inviteSummary =
				`👑 ¡Estás invitado a la Fiesta del ${partyState.age}.º Cumpleaños de la Princesa ${partyState.name}! 🏰✨\n` +
				`📅 Fecha: ${formatReadableDate(partyState.dateISO)}\n` +
				`⏰ Hora: ${partyState.timeText}\n` +
				`📍 Lugar: ${partyState.venue}\n` +
				`👗 Código de Vestimenta: ${partyState.dressCode}\n` +
				`💖 ${partyState.surpriseMessage}`;

			try {
				await navigator.clipboard.writeText(inviteSummary);
			} catch {
				const tempInput = document.createElement("textarea");
				tempInput.value = inviteSummary;
				document.body.appendChild(tempInput);
				tempInput.select();
				document.execCommand("copy");
				document.body.removeChild(tempInput);
			}

			const copyLabel = this.querySelector("#copy-btn-label");
			if (copyLabel) {
				copyLabel.textContent = "¡Copiado al Portapapeles! ✨";
				setTimeout(() => {
					copyLabel.textContent = "Copiar Detalles";
				}, 2500);
			}
			showToast(
				"¡Detalles de la invitación real copiados al portapapeles!",
			);
		};

		connectedCallback() {
			this.syncCardDetails();

			this.querySelector('[data-action="close-modal"]')?.addEventListener(
				"click",
				this.closeModal,
			);
			this.querySelector('[data-action="toggle-rsvp"]')?.addEventListener(
				"click",
				() => {
					const rsvpWall = this.querySelector(
						"rsvp-wall",
					) as RsvpWallElement | null;
					rsvpWall?.toggleDrawer();
				},
			);
			this.querySelector('[data-action="copy-invite"]')?.addEventListener(
				"click",
				this.copyInvitationText,
			);
			this.querySelector('[data-action="celebrate"]')?.addEventListener(
				"click",
				celebrateGrandFinale,
			);

			// Close on backdrop click
			const modal = this.querySelector("#invitation-modal");
			modal?.addEventListener("click", (e) => {
				if (e.target === modal) this.closeModal();
			});

			window.addEventListener("party:open-invitation", this.openModal);
			window.addEventListener("party:updated", this.syncCardDetails);
		}

		disconnectedCallback() {
			window.removeEventListener("party:open-invitation", this.openModal);
			window.removeEventListener("party:updated", this.syncCardDetails);
		}
	}

	if (!customElements.get("countdown-timer")) {
		customElements.define("countdown-timer", CountdownTimerElement);
	}
	if (!customElements.get("rsvp-wall")) {
		customElements.define("rsvp-wall", RsvpWallElement);
	}
	if (!customElements.get("invitation-modal")) {
		customElements.define("invitation-modal", InvitationModalElement);
	}
</script>
