<story-guide
	class="contents lg:w-5/12 lg:flex lg:flex-col lg:items-start lg:justify-center lg:text-left lg:order-1"
>
	<!-- Top Active Story Card / Clue (Order 1 on Mobile: Above the Cake) -->
	<div
		class="order-1 shrink-0 w-full max-w-md mt-2 md:mt-0 flex flex-col items-center lg:items-start text-center lg:text-left"
	>
		<!-- Interactive Progress Pill -->
		<div
			class="inline-flex items-center gap-1.5 bg-white/90 px-3.5 py-1 rounded-full border border-palette-pink shadow-xs mb-3.5 sm:mb-2.5"
		>
			<span
				id="step-badge"
				class="w-2 h-2 rounded-full bg-palette-gold animate-ping"
			></span>
			<span
				id="step-indicator-text"
				class="text-sm sm:text-xs font-bold uppercase tracking-wider text-palette-brown"
			>
				Paso 1 de 3 • La magia de la princesa
			</span>
		</div>

		<h2
			id="main-heading"
			class="font-script text-4xl sm:text-5xl lg:text-6xl text-palette-brown leading-normal sm:leading-tight mb-4 sm:mb-3"
		>
			¡Feliz Cumpleaños, <span
				class="dynamic-name text-palette-rose underline underline-offset-4 decoration-palette-gold/60"
				>Sofía</span
			>!
		</h2>

		<p
			id="main-instruction"
			class="text-base sm:text-lg text-palette-brown/90 bg-white/85 backdrop-blur-xs p-3.5 sm:p-4 rounded-2xl border border-palette-pink/70 shadow-xs w-full leading-snug"
		>
			El castillo real duerme bajo un velo de estrellas. <strong
				>Toca a la pequeña princesa</strong
			> para agitar su varita y despertar la magia del castillo.
		</p>
	</div>

	<!-- Bottom Fixed & Visible Primary Action Button (Order 3 on Mobile: Below the Cake) -->
	<div
		class="order-3 shrink-0 flex flex-col sm:flex-row lg:flex-col gap-1.5 sm:gap-2 w-full max-w-md pb-1 sm:pb-1 lg:mt-4"
	>
		<button
			type="button"
			id="primary-action-btn"
			data-action="primary"
			class="flex-1 w-full py-2.5 sm:py-3.5 px-5 rounded-2xl gold-badge text-white font-bold text-base sm:text-lg shadow-md hover:brightness-105 active:scale-95 transition-all flex items-center justify-center gap-2 cursor-pointer animate-glow"
		>
			<span id="primary-action-icon" aria-hidden="true">🪄</span>
			<span id="primary-action-text">Despertar la magia del castillo</span
			>
		</button>

		<button
			type="button"
			id="replay-magic-btn"
			data-action="reset-cake"
			class="hidden w-full sm:w-auto lg:w-full py-2 sm:py-3 px-4 rounded-2xl bg-white/90 hover:bg-palette-pink/30 text-palette-brown font-bold text-sm border-2 border-palette-pink shadow-xs transition-all items-center justify-center gap-1.5 active:scale-95 cursor-pointer"
		>
			<span aria-hidden="true">🔄</span>
			<span>Repetir la magia</span>
		</button>
	</div>
</story-guide>

<script>
	import { partyState, emitPartyEvent } from "../scripts/partyStore";

	class StoryGuideElement extends HTMLElement {
		private updateStepUI = () => {
			const stepIndicator = this.querySelector("#step-indicator-text");
			const instruction = this.querySelector("#main-instruction");
			const primaryIcon = this.querySelector("#primary-action-icon");
			const primaryText = this.querySelector("#primary-action-text");
			const replayBtn = this.querySelector("#replay-magic-btn");

			if (partyState.step === 1) {
				if (stepIndicator)
					stepIndicator.textContent =
						"Paso 1 de 3 • La Magia de la princesa";
				if (instruction) {
					instruction.innerHTML =
						"El castillo real aún duerme bajo un velo de estrellas. <strong>Toca a la pequeña princesa</strong> para agitar su varita y despertar la magia del castillo.";
				}
				if (primaryIcon) primaryIcon.textContent = "🪄";
				if (primaryText)
					primaryText.textContent = "Despertar la magia del castillo";
				replayBtn?.classList.add("hidden");
				replayBtn?.classList.remove("flex");
			} else if (partyState.step === 2) {
				if (stepIndicator)
					stepIndicator.textContent = "Paso 2 de 3 • El deseo real";
				if (instruction) {
					instruction.innerHTML = `¡El polvo mágico iluminó el castillo! Pide un deseo para <strong>${partyState.name}</strong> y <strong>toca las 4 velas encendidas del castillo</strong> para apagarlas.`;
				}
				if (primaryIcon) primaryIcon.textContent = "🕯️";
				if (primaryText)
					primaryText.textContent = "Soplar las velas del castillo";
				replayBtn?.classList.add("hidden");
				replayBtn?.classList.remove("flex");
			} else if (partyState.step === 3) {
				if (stepIndicator)
					stepIndicator.textContent = `Paso 3 de 3 • El secreto de la puerta #${partyState.age}`;
				if (instruction) {
					instruction.innerHTML = `¡Tu deseo desbloqueó la <strong>Puerta Floral</strong> y ahora brilla para ti! <strong>Abre la puerta mágica</strong> para descubrir la gran sorpresa.`;
				}
				if (primaryIcon) primaryIcon.textContent = "🚪";
				if (primaryText)
					primaryText.textContent = `¡Abrir la puerta mágica #${partyState.age}!`;
				replayBtn?.classList.add("hidden");
				replayBtn?.classList.remove("flex");
			} else if (partyState.step === 4) {
				if (stepIndicator)
					stepIndicator.textContent =
						"✨ Cuento Completado • ¡El Gran Tesoro!";
				if (instruction) {
					instruction.innerHTML = `¡Hurra! ¡Descubriste el gran tesoro del reino de <strong>${partyState.name}</strong>! Abre la <strong>Tarjeta de Invitación Real</strong> o repite la magia cuando quieras.`;
				}
				if (primaryIcon) primaryIcon.textContent = "💌";
				if (primaryText)
					primaryText.textContent =
						"Ver la tarjeta de Invitación Real ✨";
				replayBtn?.classList.remove("hidden");
				replayBtn?.classList.add("flex");
			}
		};

		connectedCallback() {
			this.querySelector('[data-action="primary"]')?.addEventListener(
				"click",
				() => {
					if (partyState.step === 1) {
						emitPartyEvent("party:wand-burst");
					} else if (partyState.step === 2) {
						emitPartyEvent("party:blow-all-candles");
					} else if (partyState.step === 3) {
						emitPartyEvent("party:toggle-door");
					} else {
						emitPartyEvent("party:open-invitation");
					}
				},
			);

			this.querySelector('[data-action="reset-cake"]')?.addEventListener(
				"click",
				() => {
					emitPartyEvent("party:reset-cake");
				},
			);

			window.addEventListener("party:step-changed", this.updateStepUI);
			window.addEventListener("party:updated", this.updateStepUI);
		}

		disconnectedCallback() {
			window.removeEventListener("party:step-changed", this.updateStepUI);
			window.removeEventListener("party:updated", this.updateStepUI);
		}
	}

	if (!customElements.get("story-guide")) {
		customElements.define("story-guide", StoryGuideElement);
	}
</script>
