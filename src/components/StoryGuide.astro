<story-guide
	class="w-full lg:w-5/12 flex flex-col items-center lg:items-start text-center lg:text-left order-2 lg:order-1"
>
	<!-- Interactive Progress Pill -->
	<div
		class="inline-flex items-center gap-2 bg-white/90 px-4 py-1.5 rounded-full border border-palette-pink shadow-xs mb-3"
	>
		<span
			id="step-badge"
			class="w-2.5 h-2.5 rounded-full bg-palette-gold animate-ping"
		></span>
		<span
			id="step-indicator-text"
			class="text-xs font-bold uppercase tracking-wider text-palette-brown"
		>
			Acto 1 de 3 • La Magia del Hada
		</span>
	</div>

	<h2
		id="main-heading"
		class="font-script text-4xl sm:text-5xl lg:text-6xl text-palette-brown leading-tight mb-2"
	>
		¡Feliz Cumpleaños, <span
			class="dynamic-name text-palette-rose underline decoration-palette-gold/60"
			>Sofía</span
		>!
	</h2>

	<p
		id="main-instruction"
		class="text-sm sm:text-base text-palette-brown/90 bg-white/80 backdrop-blur-xs p-4 sm:p-5 rounded-2xl border border-palette-pink/70 shadow-sm mb-5 max-w-md leading-relaxed"
	>
		El castillo real aún duerme bajo un hechizo de estrellas. <strong
			>Toca a la pequeña princesa hada</strong
		> (o el botón mágico de abajo) para agitar su varita, llenar el pastel de
		polvo de hadas y despertar la magia.
	</p>

	<!-- Single Guided Primary Action Button (+ Replay Button revealed only after Act 3) -->
	<div class="flex flex-col gap-3 w-full max-w-md">
		<button
			type="button"
			id="primary-action-btn"
			data-action="primary"
			class="w-full py-3.5 px-6 rounded-2xl gold-badge text-white font-bold text-base shadow-md hover:brightness-105 active:scale-95 transition-all flex items-center justify-center gap-2 cursor-pointer animate-glow"
		>
			<span id="primary-action-icon" aria-hidden="true">🪄</span>
			<span id="primary-action-text">Despertar la Magia del Hada</span>
		</button>

		<button
			type="button"
			id="replay-magic-btn"
			data-action="reset-cake"
			class="hidden w-full py-3 px-5 rounded-2xl bg-white/90 hover:bg-palette-pink/30 text-palette-brown font-bold text-sm border-2 border-palette-pink shadow-sm transition-all items-center justify-center gap-2 active:scale-95 cursor-pointer"
		>
			<span aria-hidden="true">🔄</span>
			<span>Repetir la Magia del Cuento</span>
		</button>
	</div>
</story-guide>

<script>
	import { partyState, emitPartyEvent } from "../scripts/partyStore";

	class StoryGuideElement extends HTMLElement {
		private updateStepUI = () => {
			const stepIndicator = this.querySelector("#step-indicator-text");
			const instruction = this.querySelector("#main-instruction");
			const primaryIcon = this.querySelector("#primary-action-icon");
			const primaryText = this.querySelector("#primary-action-text");
			const replayBtn = this.querySelector("#replay-magic-btn");

			if (partyState.step === 1) {
				if (stepIndicator)
					stepIndicator.textContent =
						"Acto 1 de 3 • La Magia del Hada";
				if (instruction) {
					instruction.innerHTML =
						"El castillo real aún duerme bajo un hechizo de estrellas. <strong>Toca a la pequeña princesa hada</strong> (o el botón mágico de abajo) para agitar su varita, llenar el pastel de polvo de hadas y despertar la magia.";
				}
				if (primaryIcon) primaryIcon.textContent = "🪄";
				if (primaryText)
					primaryText.textContent = "Despertar la Magia del Hada";
				replayBtn?.classList.add("hidden");
				replayBtn?.classList.remove("flex");
			} else if (partyState.step === 2) {
				if (stepIndicator)
					stepIndicator.textContent = "Acto 2 de 3 • El Deseo Real";
				if (instruction) {
					instruction.innerHTML = `¡El polvo de hadas ha iluminado todo el castillo! Ahora pide un hermoso deseo de cumpleaños para <strong>${partyState.name}</strong> y <strong>toca las 3 velas encendidas del castillo</strong> (o el botón de abajo) para apagarlas.`;
				}
				if (primaryIcon) primaryIcon.textContent = "🕯️";
				if (primaryText)
					primaryText.textContent = "Soplar las Velas del Castillo";
				replayBtn?.classList.add("hidden");
				replayBtn?.classList.remove("flex");
			} else if (partyState.step === 3) {
				if (stepIndicator)
					stepIndicator.textContent = `Acto 3 de 3 • El Secreto de la Puerta #${partyState.age}`;
				if (instruction) {
					instruction.innerHTML = `¡Tu deseo real ha desbloqueado la <strong>Puerta Floral #${partyState.age}</strong> del pastel! Mira cómo brilla intensamente... <strong>Toca la puerta mágica</strong> (o el botón de abajo) para abrirla y descubrir el gran tesoro.`;
				}
				if (primaryIcon) primaryIcon.textContent = "🚪";
				if (primaryText)
					primaryText.textContent = `¡Abrir la Puerta Mágica #${partyState.age}!`;
				replayBtn?.classList.add("hidden");
				replayBtn?.classList.remove("flex");
			} else if (partyState.step === 4) {
				if (stepIndicator)
					stepIndicator.textContent =
						"✨ Cuento Completado • ¡El Gran Tesoro!";
				if (instruction) {
					instruction.innerHTML = `¡Hurra! ¡Has descubierto el gran secreto del reino de <strong>${partyState.name}</strong>! Puedes volver a abrir la <strong>Tarjeta de Invitación Real</strong> o repetir la magia del cuento cuando quieras.`;
				}
				if (primaryIcon) primaryIcon.textContent = "💌";
				if (primaryText)
					primaryText.textContent =
						"Ver Tarjeta de Invitación Real ✨";
				replayBtn?.classList.remove("hidden");
				replayBtn?.classList.add("flex");
			}
		};

		connectedCallback() {
			this.querySelector('[data-action="primary"]')?.addEventListener(
				"click",
				() => {
					if (partyState.step === 1) {
						emitPartyEvent("party:wand-burst");
					} else if (partyState.step === 2) {
						emitPartyEvent("party:blow-all-candles");
					} else if (partyState.step === 3) {
						emitPartyEvent("party:toggle-door");
					} else {
						emitPartyEvent("party:open-invitation");
					}
				},
			);

			this.querySelector('[data-action="reset-cake"]')?.addEventListener(
				"click",
				() => {
					emitPartyEvent("party:reset-cake");
				},
			);

			window.addEventListener("party:step-changed", this.updateStepUI);
			window.addEventListener("party:updated", this.updateStepUI);
		}

		disconnectedCallback() {
			window.removeEventListener("party:step-changed", this.updateStepUI);
			window.removeEventListener("party:updated", this.updateStepUI);
		}
	}

	if (!customElements.get("story-guide")) {
		customElements.define("story-guide", StoryGuideElement);
	}
</script>
